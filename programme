            y, x = (i - ymin) / h, (j - xmin) / w
            # Левая верт, три горизонт, правая верт (две части)
            if (x < TH) or (abs(y) < TH) or (abs(y - 0.5) < TH) or (abs(y - 1) < TH) or (x > 1-TH):
