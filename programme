               (abs(y - (1-x)) < TH and y >= 0.5):
                sxx[i][j] = 0.5
            phase[i][j] = 2*np.pi*f[i]*t_frames[j] - np.pi/2

    zxx = sxx * np.exp(1j*phase)
    t, y = istft(zxx, fs=sr, nperseg=nperseg, noverlap=noverlap, window='boxcar', input_onesided=True)
    sf.write(audio_a, y, sr)
    return sxx

def z(sr, nperseg, noverlap, ymin, ymax, xmax, xmin, h, w, f, t_frames, sxx, phase, audio_a):
    if h <= 0 or w <= 0: return

    for i in range(ymin, ymax + 1):
        for j in range(xmin, xmax):
            y, x = (i - ymin) / h, (j - xmin) / w
            # Верх, низ, диагональ (право-верх -> лево-низ)
            if (abs(y - 0) < TH) or (abs(y - 1) < TH) or (abs(y - x) < TH):
                sxx[i][j] = 0.5
            phase[i][j] = 2*np.pi*f[i]*t_frames[j] - np.pi/2

    zxx = sxx * np.exp(1j*phase)
    t, y = istft(zxx, fs=sr, nperseg=nperseg, noverlap=noverlap, window='boxcar', input_onesided=True)
    sf.write(audio_a, y, sr)
    return sxx
    

