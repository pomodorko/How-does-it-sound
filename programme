def a(sr, nperseg, noverlap, fmin, fmax, f, a, t_frames, b, gap, sxx, phase, audio_a):
    for i in range(int(fmin/sr*2*b), int(fmax/sr*2*b)+2):
        for j in range(gap, a-gap):
            if i>(fmin+fmax)/sr*b-0.5 and i<(fmin+fmax)/sr*b+0.5 and j>(gap+a/2)/2 and j<(a-gap+a/2)/2:
                sxx[i][j]=0.5
            elif j>gap and j<a/2 and i>(fmin/sr*2*b-0.5+(j-gap)*(fmax/sr*2*b-fmin/sr*2*b)/(a/2-gap)) and i<(fmin/sr*2*b+0.5+(fmax/sr*2*b-fmin/sr*2*b)*(j-gap)/(a/2-gap)):
                sxx[i][j]=0.5
            elif j<a-gap and j>a/2 and i>(fmax/sr*2*b-0.5-(j-a/2)*(fmax/sr*2*b-fmin/sr*2*b)/(a/2-gap)) and i<(fmax/sr*2*b+0.5-(j-a/2)*(fmax/sr*2*b-fmin/sr*2*b)/(a/2-gap)):
                sxx[i][j]=0.5
            phase[i][j] = 2*np.pi*f[i]*t_frames[j] - np.pi/2

    zxx = sxx * np.exp(1j*phase)
    t, y = istft(zxx, fs=sr, nperseg=nperseg, noverlap=noverlap,
                window='boxcar', input_onesided=True)
    sf.write(audio_a, y, sr)
    print("Создан тестовый файл:", audio_a)

# Общая толщина линий для всех букв (в долях от размера буквы)
TH = 0.05
def ash(sr, nperseg, noverlap, ymin, ymax, xmax, xmin, h, w, f, t_frames, sxx, phase, audio_ash):
    if h <= 0 or w <= 0: return

    for i in range(ymin, ymax + 1):
        for j in range(xmin, xmax):
            y, x = (i - ymin) / h, (j - xmin) / w
            if (abs(y - 2*x) < TH and x < 0.5) or \
               (abs(y - 2*(1-x)) < TH and x >= 0.5) or \
               (abs(y - 0.5) < TH and abs(x - 0.5) < 0.25):
                sxx[i][j] = 0.5
            phase[i][j] = 2*np.pi*f[i]*t_frames[j] - np.pi/2

    zxx = sxx * np.exp(1j*phase)
    t, y = istft(zxx, fs=sr, nperseg=nperseg, noverlap=noverlap,
                window='boxcar', input_onesided=True)
    sf.write(audio_ash, y, sr)
    print("Создан тестовый файл:", audio_ash)

