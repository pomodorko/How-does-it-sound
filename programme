# Главный класс приложения
class GameApp(tk.Tk):
    def __init__(self):
        super().__init__()
        self.title("Моя Игра")
        self.geometry("400x300")
        
        # ИНИЦИАЛИЗАЦИЯ АУДИО (чтобы звук мог играть в фоне)
        pygame.mixer.init()
        
        # Переменная для хранения текущего экрана (фрейма)
        self.current_frame = None
        
        # Запускаем начальный экран
        self.show_start_screen()

    def clear_screen(self):
        """Удаляет все виджеты с текущего экрана"""
        if self.current_frame is not None:
            self.current_frame.destroy()

    #ЭКРАН 1: НАЧАЛО ИГРЫ
    def show_start_screen(self):
        self.clear_screen()
        self.current_frame = tk.Frame(self)
        self.current_frame.pack(expand=True, fill="both")

        # Кнопка по центру
        btn_start = tk.Button(self.current_frame, text="Начать игру", font=("Arial", 14), command=self.show_game_screen)
        btn_start.pack(side="bottom", expand=True)

        lbl_manual = tk.Label(self.current_frame, justify="center", text='Правила игры: \n Программа случайным образом выбирает заглавную латинскую букву, и генерирует такой звук, при разложении которого в спектр на спетрограмме вырисовывается соответствующая буква. Для успешного прохождения Вам нужно будет представлять как выглядит услышанный звук на спектрограмме, поэтому эта игра развивает воображение и относительный слух (умение понимать, какой звук ниже, а какой выше). \n Ответы вводите заглавными буквами.\n Если Вам всё ещё не понятно, как играть, начните игру и нажмите кнопку "Я не знаю", чтобы увидеть, что такое буква на спектрограмме. \n Удачи!', font=("Arial", 16))
        # Функция, которая обновляет ширину текста при изменении размера окна
        def update_wrap(event):
            # Ширина текста = ширина фрейма минус 40 пикселей (на отступы)
            lbl_manual.config(wraplength=event.width - 40)

        # Привязываем функцию к событию изменения размера фрейма
        self.current_frame.bind("<Configure>", update_wrap)
        lbl_manual.pack(side='top', expand=True)

    #ЭКРАН 2: ОСНОВНАЯ ИГРА
    def show_game_screen(self):
        self.clear_screen()
        sxx0.fill(0)
        phase0.fill(0)
        random_action = audio_create()
        self.sxx = random_action(sr0, nperseg0, noverlap0, ymin0, ymax0, xmax0, xmin0, h0, w0, f0, t_frames0, sxx0, phase0, audio_a0)
        self.answer = func[random_action]
        self.current_frame = tk.Frame(self)
        self.current_frame.pack(expand=True, fill="both", padx=20, pady=20)

        # Функция, которая срабатывает при нажатии на button1
        def run_play():
            # ПРОИГРЫВАНИЕ ЗВУКА
            if os.path.exists("audio.wav"):
                # .play() запускает звук в фоне, и программа идет дальше
                pygame.mixer.Sound("audio.wav").play()
            else:
                print("Ошибка: Файл audio.wav не найден в папке с программой!")

        # Верхняя кнопка (Button 1)
        button1 = tk.Button(self.current_frame, text="Прослушать звук", 
                            font=("Arial", 12), command=run_play)
        button1.pack(pady=20)

        # Поле для ввода ответа
        self.entry_answer = tk.Entry(self.current_frame, font=("Arial", 14), justify="center")
        self.entry_answer.pack(pady=10)

        # Метка для вывода ошибок (если ответ неверный)
        self.lbl_error = tk.Label(self.current_frame, text="", fg="red")
        self.lbl_error.pack()

        # Фрейм для нижних кнопок
        bottom_buttons_frame = tk.Frame(self.current_frame)
        bottom_buttons_frame.pack(side="bottom", pady=20)

        # Кнопка 1: Проверить ответ
        btn_check = tk.Button(bottom_buttons_frame, text="Ответить", width=10, 
                              command=self.check_answer)
        btn_check.pack(side="left", padx=10)

        # Кнопка 2: Не знаю
        btn_give_up = tk.Button(bottom_buttons_frame, text="Не знаю", width=10, 
                                command=self.show_give_up_screen)
        btn_give_up.pack(side="left", padx=10)

    def check_answer(self):
        """Проверка введенного ответа"""
        user_input = self.entry_answer.get()
        if user_input == self.answer:
            # Если ответ правильный, звук можно остановить (по желанию)
            pygame.mixer.stop() 
            self.show_win_screen()
        else:
            self.lbl_error.config(text="Неверно, попробуйте еще раз!")
            self.entry_answer.delete(0, tk.END)

    #ЭКРАН 3: ПОБЕДА
    def show_win_screen(self):
        self.clear_screen()
        self.current_frame = tk.Frame(self)
        self.current_frame.pack(expand=True, fill="both")

        lbl_congratulations = tk.Label(self.current_frame, text="Молодец, правильно! Вот как выглядит буква на спектре: ", 
                                       font=("Arial", 20, "bold"), fg="green")
        lbl_congratulations.pack(side="top", pady=10, expand=True)

        bottom_frame = tk.Frame(self.current_frame)
        bottom_frame.pack(side="bottom", pady=30)

        tk.Button(bottom_frame, text="Сыграть еще раз", command=self.show_game_screen).pack(side="left", padx=10)
        tk.Button(bottom_frame, text="Завершить игру", command=self.destroy).pack(side="left", padx=10)

        build_spectr(t_frames0, f0, self.sxx, self.current_frame)

    #ЭКРАН 4: ПОРАЖЕНИЕ ("НЕ ЗНАЮ")
    def show_give_up_screen(self):
        self.clear_screen()
        
        # Останавливаем звук, если он еще играет
        pygame.mixer.stop()

        self.current_frame = tk.Frame(self)
        self.current_frame.pack(expand=True, fill="both")

        lbl_answer = tk.Label(self.current_frame, text=f"Правильный ответ был:\n{self.answer}", font=("Arial", 16))
        lbl_answer.pack(side='top', expand=True)

        bottom_frame = tk.Frame(self.current_frame)
        bottom_frame.pack(side="bottom", pady=30)

        tk.Button(bottom_frame, text="Сыграть еще раз", command=self.show_game_screen).pack(side="left", padx=10)
        tk.Button(bottom_frame, text="Завершить игру", command=self.destroy).pack(side="left", padx=10)

        # Строим спектр
        build_spectr(t_frames0, f0, self.sxx, self.current_frame)


